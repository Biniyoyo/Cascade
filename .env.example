# ── CASCADE configuration ────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# DataHub (local quickstart)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=          # Personal Access Token: DataHub UI → Settings → Access Tokens

# Enable MCP write-back tools (root-cause fixes written to the graph)
TOOLS_IS_MUTATION_ENABLED=true

# Agent LLM (only needed for the deployed app in Phase 3-4, NOT for dev on the Max plan)
# Anthropic Console → set a $15 spend limit → create key. Billed separately from Claude Max.
ANTHROPIC_API_KEY=
